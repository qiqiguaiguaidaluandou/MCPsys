# 本服务对接公司接口所需的环境变量。
# 用法：复制为 .env 并填真实值（.env 已被 .gitignore，不会提交）。
#
#   cp .env.example .env
#
# service.yaml 的 required_env 里列了哪些变量，这里就要有对应的非空值，
# 否则 sync_mcp_services.py 会在起服务前报错中止。

# 公司接口基地址，例 https://erp.corp.local
UPSTREAM_BASE=

# 出站调用是否校验 TLS 证书。公司内部多为自签证书 → 默认 false 跳过。
# 想严格校验则设 true，并把公司 CA 挂进容器、让客户端 verify 指向它。
UPSTREAM_VERIFY_TLS=false

# 调用公司接口的凭据（按需改名 / 增减）
# UPSTREAM_TOKEN=
