# aftersales-search 对接公司接口所需的环境变量。
# 复制为 .env 填真实值（.env 已被 .gitignore，不会提交）：
#   cp .env.example .env
#
# 注意：监听地址/端口由镜像固定为容器内 0.0.0.0:8000，勿在此覆盖 MCP_HOST / MCP_PORT。
# 出站调用对公司接口默认跳过 TLS 校验（http_client.py verify=False），无需配置。

# ── JWT 鉴权凭证（主凭证集：CRM / GETSN / 设备档案 / FQC 都用它）──
JWT_SECRET=
JWT_ISSUER=
# LOGIN_URL 换票据专用凭证；两项留空则回退主集
LOGIN_JWT_SECRET=
LOGIN_JWT_ISSUER=

# ── MES 登录换票据 ──
LOGIN_USERNAME=
LOGIN_PASSWORD=
LOGIN_URL=
GETSN_URL=

# ── 业务接口地址 ──
SEARCH_SN_IN_SALES_POST_ORDER_URL=
GET_DEVICE_PROFILE_URL=
GET_FQC_REPORT_URL=

# ── FQC 报告下载 ──
# 报告落地目录：容器内固定挂在 /data/fqc_reports（compose 已挂卷持久化），保持默认即可。
FQC_REPORT_DIR=/data/fqc_reports
# 下载链接基地址。当前为"内网only"迁移：填服务内网地址，外部暂不可达。
# 以后若通过 nginx 对外暴露 /files/，再改成 http://<对外host>:8088
PUBLIC_BASE_URL=http://mcp-aftersales-search:8000
