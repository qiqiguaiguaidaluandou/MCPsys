# Postgres 数据库
POSTGRES_USER=mcpsys
POSTGRES_PASSWORD=changeme_in_prod
POSTGRES_DB=mcpsys
POSTGRES_PORT=5432

# Redis 缓存
REDIS_PORT=6379

# 控制平面
CONTROL_PLANE_PORT=8000
JWT_SECRET=replace_with_long_random_string_in_prod
JWT_EXPIRES_MINUTES=60
# 调用日志 body 保留（spec §7）：metadata 永久保留，request/response body 由
# 控制平面的保留 worker 在 N 天后置 NULL，行永不删除。默认 30 天、每小时清一轮。
# CALL_LOG_BODY_RETENTION_DAYS=30
# RETENTION_INTERVAL_SECONDS=3600

# 网关
GATEWAY_PORT=8080
# 是否校验上游 MCP 服务的 TLS 证书，默认 true。
# 仅在可信内网、且无法修复证书链时（如自签名 / 私有 CA 上游）才设为 false。
# 关闭会移除网关 → 上游这一段的中间人攻击防护，包括请求头里携带的 API Key。
PROXY_VERIFY_TLS=false

# 日志
LOG_LEVEL=INFO
