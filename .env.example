# Postgres
POSTGRES_USER=mcpsys
POSTGRES_PASSWORD=changeme_in_prod
POSTGRES_DB=mcpsys
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Control plane
CONTROL_PLANE_PORT=8000
JWT_SECRET=replace_with_long_random_string_in_prod
JWT_EXPIRES_MINUTES=60
# Call-log body retention (spec §7): metadata kept forever, request/response
# bodies nulled after N days by the control-plane retention worker. Rows are
# never deleted. Defaults: 30 days, swept hourly.
# CALL_LOG_BODY_RETENTION_DAYS=30
# RETENTION_INTERVAL_SECONDS=3600

# Gateway
GATEWAY_PORT=8080
# Verify upstream MCP service TLS certs. Default true.
# Set to false ONLY on trusted internal networks where you can't fix the cert
# chain (e.g. self-signed or private CA upstream). Disabling removes MITM
# protection on the gateway → upstream leg, including the API key in headers.
PROXY_VERIFY_TLS=false

# Logging
LOG_LEVEL=INFO
